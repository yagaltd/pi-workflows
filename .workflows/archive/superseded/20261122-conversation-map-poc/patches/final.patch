+/** Validation against the LIVE .workflows state (read-only, never written). */
+import { describe, expect, test } from "bun:test";
+import { existsSync, readFileSync, readdirSync } from "node:fs";
+import { join } from "node:path";
+import { extractPlan, type PlanSources } from "./extract.ts";
+import { renderDetail, renderTree, resolveNode } from "./render.ts";
+
+const REAL = "/home/aurel/Documents/github/pi-workflows/.workflows";
+const read = (name: string) => readFileSync(join(REAL, name), "utf8");
+
+function realSources(): PlanSources {
+  const reviewDir = join(REAL, "reviews");
+  const proofDir = join(REAL, "proofs");
+  const reviewFiles = existsSync(reviewDir)
+    ? readdirSync(reviewDir).filter((f) => f.endsWith(".md")).sort()
+      .map((f) => ({ path: join(reviewDir, f), text: readFileSync(join(reviewDir, f), "utf8") }))
+    : [];
+  const proofFiles = existsSync(proofDir)
+    ? readdirSync(proofDir).filter((f) => f.endsWith(".jsonl") || f.endsWith(".md")).sort()
+    : [];
+  return {
+    planText: read("plan.md"),
+    logText: read("LOG.md"),
+    reviewFiles,
+    proofText: proofFiles.map((f) => readFileSync(join(proofDir, f), "utf8")).join("\n"),
+    journalText: ["journal.jsonl", "journal.md"].filter((f) => existsSync(join(REAL, f))).map(read).join("\n"),
+  };
+}
+
+const sources = realSources();
+const graph = extractPlan(sources);
+const tree = renderTree(graph);
+const node = (id: string) => {
+  const found = graph.nodes.find((n) => n.id === id);
+  if (!found) throw new Error(`missing node ${id}`);
+  return found;
+};
+
+describe("live plan 076", () => {
+  test("identity and inline blockquote status come from plan.md:1 and :3", () => {
+    expect(sources.planText.split("\n")[0]).toContain("20261117-076");
+    expect(sources.planText.split("\n")[2]).toContain("Status: APPROVED");
+    expect(graph.id).toBe("plan-076");
+    expect(node("plan-076").status).toBe("approved");
+    expect(node("plan-076").evidence.map((e) => e.source)).toContain("plan:3");
+    expect(renderDetail(graph, "plan-076")).toContain("status APPROVED");
+    expect(tree).toContain("Plan 076");
+  });
+
+  test("plan.md has zero TASK blocks; its three phase bullets render with LOG evidence", () => {
+    expect(sources.planText).not.toMatch(/^###\s+TASK\s/mi);
+    expect(graph.nodes.filter((n) => n.kind === "task")).toHaveLength(0);
+    const phases = graph.nodes.filter((n) => n.kind === "phase");
+    expect(phases.map((n) => n.id)).toEqual(["P1", "P2", "P3"]);
+    for (const phase of phases) {
+      expect(phase.status).toBe("done");
+      expect(phase.evidence.some((e) => e.source.startsWith("plan:"))).toBe(true);
+      expect(phase.evidence.some((e) => /LOG\.md:\d+/.test(e.source))).toBe(true);
+      expect(tree).toContain(`${phase.id} `);
+    }
+    expect(sources.logText).toMatch(/20261118 PLAN 076 PHASE 1 SHIPPED/);
+    expect(node("P1").evidence.map((e) => e.source)).toContain("LOG.md:371");
+    expect(node("P3").evidence.map((e) => e.source)).toContain("LOG.md:381");
+  });
+
+  test("the post-phase-1 gate is a needs-you node with an evidenced owner answer", () => {
+    expect(node("escalation-P1").status).toBe("needs-you");
+    expect(node("escalation-P1").evidence.map((e) => e.source)).toContain("plan:37");
+    expect(node("decision-P1").status).toBe("done");
+    expect(node("decision-P1").answersId).toBe("escalation-P1");
+    expect(node("decision-P1").evidence.map((e) => e.source)).toContain("LOG.md:373");
+    expect(tree).toContain("[[Needs you]]");
+    expect(tree).toContain("[[Done]]");
+  });
+
+  test("detail follow-ups resolve phase gate aliases and print no blank status", () => {
+    expect(resolveNode(graph, "esc-p1")?.id).toBe("escalation-P1");
+    expect(resolveNode(graph, "decision-p1")?.id).toBe("decision-P1");
+    expect(renderDetail(graph, "P1")).toContain("LOG.md:371");
+    expect(renderDetail(graph, "plan-076").split("\n")[0]).not.toMatch(/\s$/);
+  });
+
+  test("no Kani layer is fabricated from proofs.jsonl (it has no Kani rows)", () => {
+    expect(sources.proofText).not.toMatch(/kani/i);
+    expect(graph.nodes.filter((n) => n.kind === "kani")).toHaveLength(0);
+    expect(tree).not.toContain("Kani");
+  });
+
+  test("a review verdict from an older plan is not borrowed into plan 076", () => {
+    expect(read("reviews/task-2.md")).toContain("ok: true");
+    expect(graph.nodes.filter((n) => n.kind === "agent-review")).toHaveLength(0);
+    expect(tree).not.toContain("task-2.md");
+  });
+});
diff --git a/prototype/poc/render.ts b/prototype/poc/render.ts
new file mode 100644
index 0000000..a4d616b
--- /dev/null
+++ b/prototype/poc/render.ts
@@ -0,0 +1,129 @@
+/** Static chat-tree renderer for the plan-level manager view. */
+
+import {
+  LAYER_ORDER, STATUS_PILL,
+  type GraphEdge, type GraphNode, type PlanGraph,
+} from "./extract.ts";
+
+const CHILD_ORDER: Record<string, number> = {
+  worker: 0, mechanical: 1, typed: 2, kani: 3, "agent-review": 4,
+  branch: 5, pending: 6, blocked: 7, escalation: 8, decision: 9,
+};
+
+const num = (id: string) => Number.parseInt(id.replace(/\D/g, ""), 10) || 0;
+const pill = (status: GraphNode["status"]) => {
+  const word = STATUS_PILL[status];
+  return word ? `[[${word}]]` : "";
+};
+
+function sortedChildren(graph: PlanGraph, id: string): GraphNode[] {
+  return graph.nodes
+    .filter((n) => n.parent === id)
+    .sort((a, b) => (CHILD_ORDER[a.kind] ?? 99) - (CHILD_ORDER[b.kind] ?? 99) || a.id.localeCompare(b.id));
+}
+
+export function resolveNode(graph: PlanGraph, ref: string): GraphNode | undefined {
+  const target = ref.trim().toLowerCase();
+  const direct = graph.nodes.find((n) => n.id.toLowerCase() === target);
+  if (direct) return direct;
+  const alias = graph.nodes.find((n) =>
+    n.summary.toLowerCase() === target || n.id.toLowerCase().endsWith(`-${target}`));
+  if (alias) return alias;
+  const digits = target.replace(/\D/g, "");
+  if (/^(esc|escalation)/.test(target) && digits) {
+    return graph.nodes.find((n) => n.id === `escalation-T${digits}` || n.id === `escalation-P${digits}`);
+  }
+  if (/^(ans|approval|decision)/.test(target) && digits) {
+    return graph.nodes.find((n) => n.id === `decision-T${digits}` || n.id === `decision-P${digits}`);
+  }
+  return undefined;
+}
+
+export function renderTree(graph: PlanGraph): string {
+  const plan = graph.nodes.find((n) => n.kind === "plan") ?? graph.nodes[0];
+  if (!plan) return "(empty plan)";
+  const planNumber = graph.id.replace(/^plan-/, "");
+  const statusWord = pill(plan.status)
+    || (plan.statusText ? `(${plan.statusText.split(/[\s(]/)[0]})` : "");
+  const lines = [
+    `Plan ${planNumber} — ${plan.summary}${statusWord ? ` ${statusWord}` : ""}`
+      + (graph.shipTarget ? ` · ship ${graph.shipTarget}` : ""),
+  ];
+  const tasks = graph.nodes
+    .filter((n) => n.kind === "task")
+    .sort((a, b) => num(a.id) - num(b.id));
+  // A phased plan has no TASK blocks; its evidence-backed phase bullets are the rows.
+  const rows = tasks.length ? tasks : graph.nodes
+    .filter((n) => n.kind === "phase")
+    .sort((a, b) => num(a.id) - num(b.id));
+
+  rows.forEach((task, index) => {
+    const children = sortedChildren(graph, task.id);
+    const layers = LAYER_ORDER.flatMap((kind) => children.filter((c) => c.kind === kind));
+    const gates = children.filter((c) => (c.kind === "pending" || c.kind === "blocked")
+      && !layers.some((l) => c.summary.split(" ")[0] === l.summary.split(" ")[0]));
+    const chips = [...layers, ...gates].map((c) => c.summary);
+    const lastTask = index === rows.length - 1;
+    lines.push(
+      `${lastTask ? "└──" : "├──"} ${task.id} ${task.summary} ${pill(task.status)}`
+        + (chips.length ? ` · ${chips.join(" · ")}` : ""),
+    );
+
+    // Workers stay in evidence/detail; forks and human asks are visible in the tree.
+    const visible = children.filter((c) => c.kind === "branch" || c.kind === "escalation");
+    visible.forEach((child, childIndex) => {
+      renderChild(child, `${lastTask ? "    " : "│   "}`, childIndex === visible.length - 1);
+    });
+  });
+
+  return lines.join("\n");
+
+  function renderChild(node: GraphNode, prefix: string, isLast: boolean) {
+    const answer = graph.nodes.find((n) => n.answersId === node.id);
+    lines.push(`${prefix}${isLast ? "└──" : "├──"} ${node.summary} ${pill(node.status)}`);
+    if (answer) {
+      lines.push(`${prefix}${isLast ? "    " : "│   "}└── ${answer.summary} ${pill(answer.status)}`);
+    }
+  }
+}
+
+export function renderEvidence(graph: PlanGraph): string {
+  const lines = ["Evidence (hidden in the default tree):"];
+  for (const node of graph.nodes) {
+    lines.push(`- ${node.id} [${node.kind}] ${node.evidence.map((e) => e.source).join(", ")}`);
+  }
+  return lines.join("\n");
+}
+
+export function renderDetail(graph: PlanGraph, ref: string): string {
+  const node = resolveNode(graph, ref);
+  if (!node) return `Unknown node: ${ref}`;
+  const lines = [
+    `${node.id} — ${node.summary} ${pill(node.status)}`.trimEnd(),
+    `Status: ${node.status}`,
+    ...(node.owner ? [`Owner: ${node.owner}`] : []),
+    `Detail: ${node.detail}`,
+    ...(node.parent ? [`Parent: ${node.parent}`] : []),
+    ...(node.answersId ? [`Answers: ${node.answersId}`] : []),
+    "Evidence:",
+    ...node.evidence.map((e) => `  - ${e.source} — ${e.label}${e.text ? ` — ${e.text}` : ""}`),
+  ];
+  const children = sortedChildren(graph, node.id);
+  if (children.length) {
+    lines.push("Children:");
+    for (const child of children) {
+      lines.push(`  - ${child.id} (${child.kind}) — ${child.summary} ${pill(child.status)}`);
+    }
+  }
+  const links = graph.edges.filter(
+    (e: GraphEdge) => (e.kind === "answers" && (e.from === node.id || e.to === node.id))
+      || (e.kind === "fork" && (e.from === node.id || e.to === node.id)),
+  );
+  if (links.length) {
+    lines.push("Links:");
+    for (const link of links) {
+      lines.push(`  - ${link.from} —${link.kind}→ ${link.to}`);
+    }
+  }
+  return lines.join("\n");
+}
